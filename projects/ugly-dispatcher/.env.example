# Crie o seu arquivo .env copiando este:
#   cp .env.example .env
#
# Depois preencha as variáveis abaixo com seus dados.

# Chave de API do Resend (obrigatória)
# Pegue em https://resend.com/api-keys
RESEND_API_KEY=re_sua_chave_aqui

# Endereço remetente (precisa estar validado no Resend)
FROM_EMAIL=despachador@seudominio.com

# Nome exibido no campo "De"
FROM_NAME=Despachador Feio

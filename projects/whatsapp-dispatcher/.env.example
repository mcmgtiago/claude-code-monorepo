# Copie este arquivo para `.env` e ajuste como quiser:
#   cp .env.example .env

# Pausa entre envios (em milissegundos).
# Padrão: 5000 (5s).
# Recomendado: 5000-10000 para evitar bloqueio do WhatsApp.
DELAY_MS=5000

# Opcional — caminho manual para Chrome/Edge, caso a detecção automática falhe.
# Windows Chrome: C:/Program Files/Google/Chrome/Application/chrome.exe
# Windows Edge:   C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# CHROME_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe

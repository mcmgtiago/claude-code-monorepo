# Copie este arquivo para .env e preencha os valores da sua conta Meta.
PORT=3001
WHATSAPP_ACCESS_TOKEN=cole_seu_token_permanente_aqui
WHATSAPP_PHONE_NUMBER_ID=cole_o_phone_number_id_aqui
# Use a versao exibida no painel WhatsApp Cloud API da Meta.
WHATSAPP_API_VERSION=v25.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# Intervalo minimo entre mensagens de uma campanha.
DEFAULT_DELAY_SECONDS=15
